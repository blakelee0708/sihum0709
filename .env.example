# Supabase (프로젝트: sihum0709 / vemoxvfthzwvyicchxzp)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 이메일 화이트리스트 (PRD 22.3) - 쉼표 구분
ADMIN_EMAILS=

# Anthropic API (PRD 8.12) - 없으면 목업 리포트가 반환됩니다
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5

# 잘림 방지선 (PRD 8.13). 원가 통제 장치가 아닙니다
AI_MAX_TOKENS=32000

# 사고량 단계 (PRD 8.13) - low / medium / high / xhigh / max
# 이 모델에서 thinking budget_tokens는 400입니다. effort로만 조절합니다
AI_EFFORT_WRITTEN=low
AI_EFFORT_INTERVIEW=medium

# 검색 API (PRD 8.10) - 없으면 목업 검색 결과가 반환됩니다
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# 카카오 (PRD 11.3 talk_message 스코프)
NEXT_PUBLIC_KAKAO_JS_KEY=

# Slack 알림 (PRD 14.16, 22.6)
SLACK_WEBHOOK_URL=

# 사이트 URL (OAuth 리다이렉트)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
